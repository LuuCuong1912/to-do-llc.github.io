            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Người Thử Postman\",\n  \"email\": \"{{email}}\",\n  \"password\": \"matkhau123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
