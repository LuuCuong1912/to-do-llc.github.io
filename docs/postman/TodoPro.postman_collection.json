              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"matkhau123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
