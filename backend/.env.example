# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env

NODE_ENV=development
PORT=3000

# Địa chỉ Frontend (Live Server) — dùng cho CORS
CLIENT_URL=http://127.0.0.1:5500

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=todopro

# JWT — tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=1d
