# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env

NODE_ENV=development
PORT=3000

# Địa chỉ Frontend (Live Server) — dùng cho CORS, nhiều địa chỉ cách nhau bởi dấu phẩy.
# Địa chỉ ĐẦU TIÊN là nơi VNPay đưa người dùng quay về sau khi thanh toán.
CLIENT_URL=http://127.0.0.1:5500,http://localhost:5500

# MySQL — dùng user riêng cho dự án (không dùng root). Tạo trong MySQL Workbench:
#   CREATE USER 'todopro'@'localhost' IDENTIFIED BY 'mat_khau';
#   GRANT ALL PRIVILEGES ON todopro.* TO 'todopro'@'localhost';
# Sau đó chạy: npm run db:setup
DB_HOST=localhost
DB_PORT=3306
DB_USER=todopro
DB_PASSWORD=
DB_NAME=todopro
# MySQL trên cloud (Aiven, TiDB Cloud...) bắt buộc SSL: DB_SSL=true + DB_SSL_CA = nội dung file ca.pem
# (dán nhiều dòng, hoặc 1 dòng với \n). MySQL trên máy cá nhân: để trống.
DB_SSL=
DB_SSL_CA=

# JWT — tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=1d

# ---------- Thanh toán ----------
# Thanh toán giả lập (demo). Đặt false để ẩn khi chạy thật.
PAYMENT_MOCK_ENABLED=true

# VNPay sandbox — đăng ký tại https://sandbox.vnpayment.vn/devreg/ để nhận TMN_CODE + HASH_SECRET.
# Để trống → phương thức VNPay tự ẩn.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://127.0.0.1:3000/api/payments/vnpay/return
# Chỉ khi dev trên máy cá nhân: VNPay không gọi được IPN vào localhost → xác nhận đơn ngay ở Return URL.
# Production luôn để false (chỉ tin IPN).
VNP_CONFIRM_ON_RETURN=false

# ---------- Deploy ----------
# true: Express phục vụ luôn thư mục frontend/ (deploy 1 dịch vụ, cùng tên miền)
SERVE_FRONTEND=false
# true khi chạy sau proxy (Render, Railway, Nginx...)
TRUST_PROXY=false
# lax (mặc định, Frontend + Backend cùng tên miền) | none (khác tên miền, bắt buộc HTTPS)
COOKIE_SAMESITE=lax
